# OpenAI cho chatbot trang chủ (chỉ dùng phía server, KHÔNG thêm tiền tố NEXT_PUBLIC_)
OPENAI_API_KEY=
# Tuỳ chọn: đổi model chatbot (mặc định gpt-5.6-luna)
OPENAI_CHAT_MODEL=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=